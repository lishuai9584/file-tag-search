# 自动检测文本文件的行尾符
* text=auto

# Java源代码使用LF
*.java text eol=lf

# 配置文件使用LF
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# SQL脚本使用LF
*.sql text eol=lf

# Shell脚本使用LF
*.sh text eol=lf

# Windows批处理文件使用CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Markdown文档使用LF
*.md text eol=lf

# HTML文件使用LF
*.html text eol=lf

# CSS和JavaScript使用LF
*.css text eol=lf
*.js text eol=lf

# 二进制文件标记为binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.war binary
*.ear binary
*.zip binary
*.tar.gz binary
